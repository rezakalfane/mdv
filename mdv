"""


def h_text(s):
    """Escape plain text; keep a few simple tags (without attributes), drop the other HTML."""
    out, pos = [], 0
    for m in TAG_RE.finditer(s):
        out.append(html.escape(s[pos : m.start()], quote=False))
        pos = m.end()
        name = re.match(r"</?(\w+)", m.group(0)).group(1).lower()
        if name in HTML_KEEP:
            out.append("<%s%s>" % ("/" if m.group(0).startswith("</") else "", name))
    out.append(html.escape(s[pos:], quote=False))
    return "".join(out)


def h_inline(text):
    out, pos = [], 0
    for m in INLINE_RE.finditer(text):
        out.append(h_text(text[pos : m.start()]))
        pos = m.end()
        g = m.group
        if g("tick"):
            out.append("<code>%s</code>" % html.escape(g("code").strip(), quote=False))
        elif g("src") is not None:
            out.append('<img src="%s" alt="%s">' % (html.escape(g("src")), html.escape(g("alt"))))
        elif g("ltext"):
            out.append('<a href="%s">%s</a>' % (html.escape(g("url")), h_inline(g("ltext"))))
        elif g("auto"):
            out.append('<a href="%s">%s</a>' % (html.escape(g("auto")), html.escape(g("auto"), quote=False)))
        elif g("bold"):
            out.append("<strong>%s</strong>" % h_inline(g("bold")))
        elif g("strike"):
            out.append("<del>%s</del>" % h_inline(g("strike")))
        elif g("em") or g("em2"):
            out.append("<em>%s</em>" % h_inline(g("em") or g("em2")))
        elif g("esc"):
            out.append(html.escape(g("esc"), quote=False))
    out.append(h_text(text[pos:]))
    return "".join(out).replace("\n", "<br>")


def h_heading(level, text):
    inner = h_inline(text)
    plain_text = html.unescape(re.sub(r"<[^>]+>", "", inner))
    if level == 1 and HCTX["title"] is None:
        HCTX["title"] = plain_text
    base = slug(plain_text) or "section"
    n = HCTX["ids"].get(base, 0)
    HCTX["ids"][base] = n + 1
    return '<h%d id="%s">%s</h%d>' % (level, base if not n else "%s-%d" % (base, n), inner, level)


def h_code(body, lang=""):
    while body and not body[0].strip():
        body.pop(0)
    while body and not body[-1].strip():
        body.pop()
    code = "\n".join(body)
    inner, lexer = None, find_lexer(lang) if lang else None
    if lexer is not None:
        try:
            from pygments import format as pyg_format
            from pygments.formatters import HtmlFormatter

            tokens = lexer.get_tokens(code)
            if {"bash", "sh", "console", "shell-session"} & set(lexer.aliases):
                tokens = shell_tokens(tokens)
            inner = pyg_format(tokens, HtmlFormatter(nowrap=True)).rstrip("\n")
        except Exception:
            inner = None
    if inner is None:
        inner = html.escape(code, quote=False)
    label = '<div class="lang">%s</div>' % html.escape(lang) if lang else ""
    return '<figure class="code%s">%s<pre><code>%s</code></pre></figure>' % (
        " short" if len(body) <= 30 else "", label, inner)


def h_table(rows):
    header = split_row(rows[0])
    ncol = len(header)
    aligns = []
    for c in split_row(rows[1])[:ncol]:
        aligns.append("c" if c.startswith(":") and c.endswith(":") else "r" if c.endswith(":") else "")
    aligns += [""] * (ncol - len(aligns))

    def cells(tag, row):
        return "".join(
            "<%s%s>%s</%s>" % (tag, ' class="%s"' % a if a else "", h_inline(c), tag)
            for c, a in zip((row + [""] * ncol)[:ncol], aligns)
        )

    body = "".join("<tr>%s</tr>" % cells("td", split_row(r)) for r in rows[2:])
    return "<table><thead><tr>%s</tr></thead><tbody>%s</tbody></table>" % (cells("th", header), body)


def h_quote(body):
    kind = None
    if body and (a := ALERT_RE.match(body[0])):
        kind, body = a.group(1).lower(), body[1:]
    inner = h_blocks(body)
    if kind:
        return '<aside class="alert %s"><p class="alert-title">%s</p>%s</aside>' % (kind, kind.title(), inner)
    return "<blockquote>%s</blockquote>" % inner


def h_list(lines, i):
    items, loose, ordered, start, i = parse_list(lines, i)
    out = []
    for body in items:
        task = re.match(r"^\[([ xX])\]\s+(.*)$", body[0])
        box = ""
        if task:
            box = '<span class="box%s">%s</span>' % (" done" if task.group(1) != " " else "", "✔" if task.group(1) != " " else "")
            body[0] = task.group(2)
        out.append("<li%s>%s%s</li>" % (' class="task"' if task else "", box, h_blocks(body, tight=not loose)))
    tag = "ol" if ordered else "ul"
    return "<%s%s>%s</%s>" % (tag, ' start="%d"' % start if ordered and start != 1 else "", "".join(out), tag), i


def h_blocks(lines, tight=False):
    out, i, n = [], 0, len(lines)
    while i < n:
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        if m := FENCE_RE.match(line):
            ind, fence, lang = len(m.group(1)), m.group(2), m.group(3)
            close = re.compile(r"^\s*%s{%d,}\s*$" % (re.escape(fence[0]), len(fence)))
            body, i = [], i + 1
            while i < n and not close.match(lines[i]):
                body.append(lines[i][min(ind, indent_of(lines[i])) :])
                i += 1
            i += 1
            out.append(h_code(body, lang))
        elif m := HEADING_RE.match(line):
            out.append(h_heading(len(m.group(1)), m.group(2)))
            i += 1
        elif HR_RE.match(line):
            out.append("<hr>")
            i += 1
        elif QUOTE_RE.match(line):
            body = []
            while i < n and lines[i].strip():
                if q := QUOTE_RE.match(lines[i]):
                    body.append(q.group(1))
                elif starts_block(lines, i):
                    break
                else:
                    body.append(lines[i])
                i += 1
            out.append(h_quote(body))
        elif LIST_RE.match(line):
            block, i = h_list(lines, i)
            out.append(block)
        elif is_table(lines, i):
            rows = [lines[i], lines[i + 1]]
            i += 2
            while i < n and lines[i].strip() and "|" in lines[i]:
                rows.append(lines[i])
                i += 1
            out.append(h_table(rows))
        elif line.startswith("    "):
            body = []
            while i < n and (lines[i].startswith("    ") or not lines[i].strip()):
                body.append(lines[i][4:])
                i += 1
            out.append(h_code(body))
        else:
            para, level = [line], 0
            i += 1
            while i < n and lines[i].strip():
                if s := SETEXT_RE.match(lines[i]):
                    level = 1 if s.group(1)[0] == "=" else 2
                    i += 1
                    break
                if starts_block(lines, i):
                    break
                para.append(lines[i])
                i += 1
            text = ""
            for k, p in enumerate(para):
                hard = p.endswith("  ") or p.rstrip().endswith("\\")
                s = p.strip()
                s = s[:-1] if s.endswith("\\") else s
                text += s + ("\n" if hard and k < len(para) - 1 else " ")
            text = re.sub(r"<br\s*/?>", "\n", text.strip(), flags=re.I)
            if level:
                out.append(h_heading(level, text))
            elif tight:
                out.append(h_inline(text))
            else:
                figure = re.fullmatch(r"!\[[^\]]*\]\([^)]*\)", text)
                out.append('<p%s>%s</p>' % (' class="figure"' if figure else "", h_inline(text)))
    return "\n".join(out)


def html_document(text, name, base, paper="A4", source_lang=None):
    """A complete, print-styled HTML page for a Markdown document (or a source file)."""
    HCTX["ids"], HCTX["title"] = {}, None
    text = text.expandtabs(4)
    if source_lang is not None:
        body = h_code(text.split("\n"), source_lang)
    else:
        text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
        lines = text.splitlines()
        front = ""
        if lines and lines[0].strip() == "---":  # YAML front matter
            for k in range(1, len(lines)):
                if lines[k].strip() in ("---", "..."):
                    front, lines = h_code(lines[1:k], "yaml"), lines[k + 1 :]
                    break
        body = front + h_blocks(lines)
    title = HCTX["title"] or name
    css = PDF_CSS.replace("@@PAPER@@", paper).replace(
        "@@TITLE@@", title.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " "))
    try:
        from pygments.formatters import HtmlFormatter

        css += HtmlFormatter(style="friendly").get_style_defs("figure.code")
        css += "figure.code .hll, figure.code .w { background: none; }\n"
    except ImportError:
        pass
    return (
        '<!DOCTYPE html>\n<html lang="en"><head><meta charset="utf-8"><title>%s</title>\n'
        '<base href="%s"><style>%s</style></head>\n<body>\n%s\n</body></html>\n'
        % (html.escape(title, quote=False), html.escape(pathlib.Path(os.path.abspath(base)).as_uri() + "/"), css, body)
    )


def find_browser():
    """A Chromium-based browser able to print PDFs headlessly, or None."""
    if os.environ.get("MDV_CHROME"):
        return os.environ["MDV_CHROME"]
    for name in ("google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "chrome",
                 "microsoft-edge", "brave-browser"):
        if path := shutil.which(name):
            return path
    for path in (
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
        "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser",
    ):
        if os.access(path, os.X_OK):
            return path
    return None


def write_pdf(page_html, out_path):
    """Print an HTML page to a PDF file. Returns an error message, or None on success."""
    out_path = os.path.abspath(out_path)
    browser, weasy = find_browser(), shutil.which("weasyprint")
    if not browser and not weasy:
        return ("--pdf needs Google Chrome (or Chromium, Edge, Brave; set MDV_CHROME to its path) "
                "or WeasyPrint (pip install weasyprint)")
    with tempfile.TemporaryDirectory(prefix="mdv-") as tmp:
        src = os.path.join(tmp, "doc.html")
        with open(src, "w", encoding="utf-8") as f:
            f.write(page_html)
        if os.path.exists(out_path):
            os.remove(out_path)
        if browser:
            cmd = [browser, "--headless", "--disable-gpu", "--no-pdf-header-footer", "--hide-scrollbars",
                   "--run-all-compositor-stages-before-draw", "--virtual-time-budget=15000",
                   "--user-data-dir=" + os.path.join(tmp, "profile"), "--print-to-pdf=" + out_path,
                   pathlib.Path(src).as_uri()]
        else:
            cmd = [weasy, src, out_path]
        try:
            run = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
        except (OSError, subprocess.TimeoutExpired) as e:
            return "could not run %s: %s" % (os.path.basename(cmd[0]), e)
        if not os.path.exists(out_path) or os.path.getsize(out_path) == 0:
            tail = (run.stderr or run.stdout or "").strip().splitlines()[-3:]
            return "%s produced no PDF%s" % (os.path.basename(cmd[0]), (": " + " | ".join(tail)) if tail else "")
    return None


# ---------------------------------------------------------------------- main


MARKDOWN_EXT = (".md", ".markdown", ".mdown", ".mkd")
MAX_FILE = 5 * 1024 * 1024


def slug(text):
    """GitHub-style heading anchor."""
    return re.sub(r"[^\w\- ]", "", text.lower()).strip().replace(" ", "-")


def link_spans(line):
    """Screen columns of the links on a rendered line: [(start, end, link id)]."""
    spans, col, open_at = [], 0, {}
    for m in re.finditer(r"\x1b\[[0-9;]*m|.", line, re.S):
        ch = m.group(0)
        if ch.startswith("\x1b"):
            continue
        code = ord(ch)
        if LINK_START <= code < LINK_END:
            open_at[code - LINK_START] = col
        elif code >= ZONE_BASE:
            continue
        elif code >= LINK_END:
            lid = code - LINK_END
            spans.append((open_at.pop(lid, 0), col, lid))
        else:
            col += vwidth(ch)
    spans += [(c0, col, lid) for lid, c0 in open_at.items()]  # link continues on the next line
    return spans


TOKEN_RE = re.compile(r"\x1b\[[0-9;]*m|.", re.S)


def walk_line(line):
    """Yield (token, column, zone) for a rendered line; zone is None for invisible tokens."""
    col, zone, skip = 0, BODY, False
    for m in TOKEN_RE.finditer(line):
        tok = m.group(0)
        code = ord(tok) if len(tok) == 1 else 0
        if code >= ZONE_BASE:
            if code - ZONE_BASE == SKIP:
                skip = True
            elif code - ZONE_BASE not in FLAGS:
                zone = code - ZONE_BASE
            yield tok, col, None
        elif tok[0] == "\x1b" or code >= LINK_START:
            yield tok, col, None
        else:
            yield tok, col, DECO if skip else zone
            skip = False
            col += vwidth(tok)


def zone_at(line, col):
    zone = BODY
    for _, c, z in walk_line(line):
        if z is not None:
            if c > col:
                break
            zone = z
    return zone


def selection_zone(lines, a, b):
    """A selection that starts and ends in the same code block or table column stays inside it."""
    za, zb = zone_at(lines[a[0]], a[1]), zone_at(lines[b[0]], b[1])
    return za if za == zb and za > DECO else None


def is_selected(pos, zone, a, b, only):
    if zone is None or zone == DECO or (only is not None and zone != only):
        return False
    return a <= pos <= b


def selected_text(lines, a, b, only="auto"):
    """The text of a selection: decoration dropped, wrapped lines rejoined, table cells tab-separated."""
    if only == "auto":
        only = selection_zone(lines, a, b)
    rows = []  # per screen line: [zone, text, soft break or None] segments
    for ln in range(a[0], b[0] + 1):
        segs, visible = [], False
        for tok, col, z in walk_line(lines[ln]):
            if z is None:
                flag = ord(tok) - ZONE_BASE if len(tok) == 1 else -1
                if flag in (SOFT_SPACE, SOFT_JOIN) and segs:
                    segs[-1][2] = " " if flag == SOFT_SPACE else ""
                continue
            visible = True
            if is_selected((ln, col), z, a, b, only):
                if segs and segs[-1][0] == z and segs[-1][2] is None:
                    segs[-1][1] += tok
                else:
                    segs.append([z, tok, None])
        if segs:
            rows.append(segs)
        elif not visible and only is None:
            rows.append([])  # a real blank line, not a border

    merged = []
    for segs in rows:
        prev = merged[-1] if merged else None
        if prev and segs and any(seg[2] is not None for seg in prev):
            # This screen line continues the previous one: join each zone with its own text.
            for z, t, soft in segs:
                same = next((seg for seg in prev if seg[0] == z), None)
                if same is None:
                    prev.append([z, t, soft])
                elif same[2] == "":
                    same[1], same[2] = same[1] + t, soft
                else:
                    same[1], same[2] = same[1].rstrip(" ") + " " + t.lstrip(" "), soft
        else:
            merged.append(segs)

    out = []
    for segs in merged:
        text = ""
        for k, (z, t, _) in enumerate(segs):
            if k and z > DECO and segs[k - 1][0] > DECO:
                text = text.rstrip(" ") + "\t"
            text += t
        out.append(text.rstrip())
    return "\n".join(out).strip("\n")


WORD_RE = re.compile(r"[\w\-./~@+:%#?=&]")


def word_at(line, col):
    """(first column, last column, zone) of the word under a column, or None."""
    cells = [(c, tok, z) for tok, c, z in walk_line(line) if z is not None]
    k = next((i for i in range(len(cells) - 1, -1, -1) if cells[i][0] <= col), None)
    if k is None or cells[k][2] == DECO or not WORD_RE.match(cells[k][1]):
        return None
    zone = cells[k][2]

    def part_of_word(i):
        return 0 <= i < len(cells) and cells[i][2] == zone and WORD_RE.match(cells[i][1])

    i = j = k
    while part_of_word(i - 1):
        i -= 1
    while part_of_word(j + 1):
        j += 1
    while j > i and cells[j][1] in ".,:;?!":  # sentence punctuation is not part of the word
        j -= 1
    return cells[i][0], cells[j][0], zone


def block_at(lines, ln, col):
    """(first line, last line, zone) of the text block under a position, or None.

    A block is a paragraph or list item for body text, or the whole run of a
    code block or table cell.
    """
    zone = zone_at(lines[ln], col)
    if zone == DECO:
        return None

    def has_zone(line):
        return any(z == zone for _, _, z in walk_line(line))

    def item_start(line):
        lead = ""
        for tok, _, z in walk_line(line):
            if z is None:
                continue
            if z != DECO:
                break
            lead += tok
        return bool(re.search(r"[•◦▪▫✔☐]|\d+\.", lead))

    first = last = ln
    while first > 0 and has_zone(lines[first - 1]) and not (zone == BODY and item_start(lines[first])):
        first -= 1
    while last + 1 < len(lines) and has_zone(lines[last + 1]) and not (zone == BODY and item_start(lines[last + 1])):
        last += 1
    return first, last, zone


def paint_selection(line, ln, a, b, only):
    out, on = [], False
    for tok, col, z in walk_line(line):
        if z is None:
            out.append(tok)
            if on and tok[0] == "\x1b":
                out.append("\x1b[7m")  # a style change inside the selection
            continue
        inside = is_selected((ln, col), z, a, b, only)
        if inside != on:
            out.append("\x1b[7m" if inside else "\x1b[27m")
            on = inside
        out.append(tok)
    if on:
        out.append("\x1b[27m")
    return "".join(out)


def copy_to_clipboard(text, tty_fd):
    """System clipboard tool if there is one, else the OSC 52 escape sequence."""
    import base64

    env = dict(os.environ)
    env.setdefault("LANG", "en_US.UTF-8")
    if sys.platform == "darwin":
        tools = [["pbcopy"]]
    else:
        tools = [["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "--clipboard", "--input"]]
    for cmd in tools:
        try:
            subprocess.run(cmd, input=text.encode("utf-8"), env=env, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=3, check=True)
            return
        except (OSError, subprocess.SubprocessError):
            continue
    os.write(tty_fd, b"\x1b]52;c;" + base64.b64encode(text.encode("utf-8")) + b"\x07")


def page(first, open_path, mouse=True):
    """Full-screen viewer that re-renders when the window is resized and follows links.

    `first` and the documents returned by `open_path(path)` are dicts with a
    "title" and a "build(cols) -> (lines, links)" function. Returns False if no
    terminal is available (the caller then prints instead).
    """
    import select
    import signal
    import termios
    import time
    import tty

    try:
        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return False
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)

    def on_resize(*_):
        try:
            os.write(wake_w, b"r")
        except BlockingIOError:
            pass

    def new_view(doc, anchor=None):
        return {"doc": doc, "lines": [], "links": [], "occ": [], "cols": 0, "top": 0, "sel": None,
                "anchor": anchor, "spans": {}, "selection": None, "sel_zone": "auto"}

    out = sys.stdout
    st = {"cur": new_view(first), "stack": [], "query": "", "input": None, "msg": "", "drag": None, "flash": None}

    def flash(msg, seconds=2.5):
        """A status message that disappears by itself."""
        st["msg"], st["flash"] = msg, (msg, time.time() + seconds)

    def size():
        sz = os.get_terminal_size(fd)
        return max(sz.columns, 10), max(sz.lines, 2)

    def clip(line, cols):
        return chunks(line, cols)[0] if vwidth(line) > cols else line

    def describe(link):
        kind, target, anchor = link
        if kind == "url":
            return target
        return (os.path.relpath(target) if target else "") + ("#" + anchor if anchor else "")

    def jump_to_anchor(cur, anchor):
        want = slug(urllib.parse.unquote(anchor))
        for ln, line in enumerate(cur["lines"]):
            if slug(plain(line)) == want:
                cur["top"] = ln
                return
        st["msg"] = "Section not found: #" + anchor

    def layout(cur, cols):
        """(Re-)render the document for a width, keeping position and selection."""
        frac = cur["top"] / len(cur["lines"]) if cur["lines"] else 0
        sel_id = cur["occ"][cur["sel"]][1] if cur["sel"] is not None else None
        cur["lines"], cur["links"] = cur["doc"]["build"](cols)
        cur["cols"] = cols
        cur["selection"] = None  # positions change with the width
        cur["occ"] = [(ln, ord(ch) - LINK_START) for ln, line in enumerate(cur["lines"])
                      for ch in line if LINK_START <= ord(ch) < LINK_END]
        cur["top"] = round(frac * len(cur["lines"]))
        cur["sel"] = next((k for k, (_, lid) in enumerate(cur["occ"]) if lid == sel_id), None)
        if cur["anchor"]:
            jump_to_anchor(cur, cur["anchor"])
            cur["anchor"] = None

    def draw():
        cur = st["cur"]
        cols, rows = size()
        body = rows - 1
        if cols != cur["cols"]:
            layout(cur, cols)
        lines = cur["lines"]
        cur["top"] = min(max(cur["top"], 0), max(len(lines) - body, 0))
        top = cur["top"]
        sel = cur["occ"][cur["sel"]][1] if cur["sel"] is not None else None
        buf, cur["spans"] = ["\x1b[H"], {}
        selection = None
        if cur["selection"]:
            a, b = sorted(cur["selection"])
            only = selection_zone(lines, a, b) if cur["sel_zone"] == "auto" else cur["sel_zone"]
            selection = (a, b, only)
        for k in range(body):
            line = lines[top + k] if top + k < len(lines) else ""
            if selection and selection[0][0] <= top + k <= selection[1][0]:
                line = paint_selection(line, top + k, *selection)
            if MARK_RE.search(line):
                cur["spans"][k] = link_spans(line)
                if sel is not None:
                    s, e = chr(LINK_START + sel), chr(LINK_END + sel)
                    if e in line and s not in line:
                        line = "\x1b[7m" + line
                    line = line.replace(s, s + "\x1b[7m").replace(e, "\x1b[27m" + e)
                line = MARK_RE.sub("", line)
            buf.append("\x1b[K" + clip(line, cols) + "\x1b[0m\r\n")
        end = min(top + body, len(lines))
        if st["input"] is not None:
            left, right = "/" + st["input"], ""
        else:
            pct = 100 if end >= len(lines) else end * 100 // max(len(lines), 1)
            back = "  ← back" if st["stack"] else ""
            if st["msg"]:
                left = " " + st["msg"]
            elif sel is not None:
                left = " → " + describe(cur["links"][sel]) + "   (Enter to open)"
            else:
                left = " " + cur["doc"]["title"]
            right = "%d-%d/%d %3d%%   Tab link%s  / search  q quit " % (top + 1, end, len(lines), pct, back)
        status = left + " " * max(cols - vwidth(left) - vwidth(right), 1) + right
        buf.append("\x1b[K\x1b[7m" + clip(status, cols) + "\x1b[0m")
        buf.append("\x1b[?25h" if st["input"] is not None else "\x1b[?25l")
        out.write("".join(buf))
        out.flush()

    def search(direction):
        cur = st["cur"]
        q, lines = st["query"].lower(), cur["lines"]
        for step in range(1, len(lines) + 1):
            idx = (cur["top"] + direction * step) % len(lines)
            if q in plain(lines[idx]).lower():
                cur["top"] = idx
                return
        st["msg"] = "Not found: " + st["query"]

    def select_link(direction, body):
        cur = st["cur"]
        occ, top = cur["occ"], cur["top"]
        if not occ:
            st["msg"] = "No links in this document"
            return
        if cur["sel"] is not None and top <= occ[cur["sel"]][0] < top + body:
            k = (cur["sel"] + direction) % len(occ)
        elif direction > 0:
            k = next((k for k, (ln, _) in enumerate(occ) if ln >= top), 0)
        else:
            k = next((k for k in range(len(occ) - 1, -1, -1) if occ[k][0] < top + body), len(occ) - 1)
        cur["sel"] = k
        ln = occ[k][0]
        if not top <= ln < top + body:
            cur["top"] = ln - body // 3

    def follow():
        cur = st["cur"]
        kind, target, anchor = cur["links"][cur["occ"][cur["sel"]][1]]
        if kind == "url":
            opener = "open" if sys.platform == "darwin" else "xdg-open"
            try:
                subprocess.Popen([opener, target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                st["msg"] = "Opened in browser: " + target
            except OSError:
                st["msg"] = "Cannot open " + target
        elif target is None:  # link to a section of this document
            st["stack"].append(dict(cur))
            jump_to_anchor(cur, anchor)
        else:
            doc, err = open_path(target)
            if err:
                st["msg"] = err
            else:
                st["stack"].append(cur)
                st["cur"] = new_view(doc, anchor)

    def go_back():
        if st["stack"]:
            st["cur"] = st["stack"].pop()
        else:
            st["msg"] = "Nothing to go back to"

    def click(x, y):
        """Follow the link under the pointer; True if there was one."""
        cur = st["cur"]
        for c0, c1, lid in cur["spans"].get(y, []):
            if c0 <= x < c1:
                cur["sel"] = next(k for k, (ln, i) in enumerate(cur["occ"]) if i == lid)
                follow()
                return True
        return False

    def copy_selection():
        cur = st["cur"]
        text = selected_text(cur["lines"], *sorted(cur["selection"]), only=cur["sel_zone"])
        if text:
            copy_to_clipboard(text, fd)
            flash("Copied %d character%s to the clipboard" % (len(text), "" if len(text) == 1 else "s"))
        else:
            cur["selection"] = None

    def multi_click(x, y):
        """Count quick clicks at the same place: 1 = link, 2 = word, 3 = block."""
        cur = st["cur"]
        ln, now, last = cur["top"] + y, time.time(), st.get("last_click")
        same = last and now - last[0] < 0.45 and last[1] == ln and abs(last[2] - x) <= 1 and last[4] is cur
        count = last[3] % 3 + 1 if same else 1
        st["last_click"] = (now, ln, x, count, cur)
        if ln >= len(cur["lines"]):
            return
        if count == 1:
            if click(x, y):
                st["last_click"] = None  # the click opened a link: don't count it towards a double-click
            return
        found = word_at(cur["lines"][ln], x) if count == 2 else block_at(cur["lines"], ln, x)
        if not found:
            return
        if count == 2:
            c0, c1, zone = found
            cur["selection"], cur["sel_zone"] = ((ln, c0), (ln, c1)), zone
        else:
            first, last_ln, zone = found
            cur["selection"], cur["sel_zone"] = ((first, 0), (last_ln, 10 ** 9)), zone
        copy_selection()

    def handle(key):
        """Process one key or mouse event; return False to quit."""
        cur = st["cur"]
        body = size()[1] - 1
        if key.startswith("\x1b[<"):  # SGR mouse event: ESC [ < button ; x ; y M|m
            button, x, y = (int(v) for v in key[3:-1].split(";"))
            x, y, pressed = x - 1, y - 1, key.endswith("M")
            if button == 64:
                cur["top"] -= 3
            elif button == 65:
                cur["top"] += 3
            elif button == 0 and pressed:  # button down: maybe a click, maybe a selection
                st["msg"], cur["selection"] = "", None
                cur["sel_zone"] = "auto"
                st["drag"] = {"start": (cur["top"] + y, x), "moved": False, "x": x, "y": y}
            elif button == 32 and pressed and st["drag"]:  # moved with the button held
                if y <= 0:
                    cur["top"] = max(cur["top"] - 1, 0)  # dragging past the edges scrolls
                elif y >= body - 1:
                    cur["top"] = min(cur["top"] + 1, max(len(cur["lines"]) - body, 0))
                ln = min(max(cur["top"] + min(max(y, 0), body - 1), 0), max(len(cur["lines"]) - 1, 0))
                st["drag"]["moved"] = True
                cur["selection"] = (st["drag"]["start"], (ln, max(x, 0)))
            elif not pressed and st["drag"]:  # button up
                drag, st["drag"] = st["drag"], None
                if not drag["moved"]:
                    multi_click(drag["x"], drag["y"])
                elif cur["selection"]:
                    copy_selection()
            return True
        if st["input"] is not None:
            if key in ("\r", "\n"):
                st["query"], st["input"] = st["input"] or st["query"], None
                if st["query"]:
                    search(1)
            elif key in ("\x1b", "\x03", "\x07"):
                st["input"] = None
            elif key in ("\x7f", "\x08"):
                st["input"] = st["input"][:-1]
            elif len(key) == 1 and key.isprintable():
                st["input"] += key
            return True
        st["msg"] = ""
        if key == "\x1b":
            cur["selection"] = None
        moves = {
            "j": 1, "\x1b[B": 1, "\x1bOB": 1, "\n": 1, "e": 1,
            "k": -1, "\x1b[A": -1, "\x1bOA": -1, "y": -1,
            " ": body, "f": body, "\x1b[6~": body, "\x06": body,
            "b": -body, "\x1b[5~": -body, "\x02": -body,
            "d": body // 2, "\x04": body // 2, "u": -(body // 2), "\x15": -(body // 2),
        }
        if key in ("q", "Q", "\x03"):
            return False
        if key == "\r":
            if cur["sel"] is not None and cur["top"] <= cur["occ"][cur["sel"]][0] < cur["top"] + body:
                follow()
            else:
                cur["top"] += 1
        elif key in moves:
            cur["top"] += moves[key]
        elif key in ("g", "<", "\x1b[H", "\x1bOH", "\x1b[1~"):
            cur["top"] = 0
        elif key in ("G", ">", "\x1b[F", "\x1bOF", "\x1b[4~"):
            cur["top"] = len(cur["lines"])
        elif key == "\t":
            select_link(1, body)
        elif key == "\x1b[Z":
            select_link(-1, body)
        elif key in ("\x7f", "\x08", "\x1b[D", "\x1bOD", "h"):
            go_back()
        elif key == "/":
            st["input"] = ""
        elif key in ("n", "N") and st["query"]:
            search(1 if key == "n" else -1)
        return True

    mouse_on, mouse_off = ("\x1b[?1002h\x1b[?1006h", "\x1b[?1006l\x1b[?1002l") if mouse else ("", "")
    old_attrs = termios.tcgetattr(fd)
    old_handler = signal.signal(signal.SIGWINCH, on_resize)
    try:
        tty.setraw(fd)
        out.write("\x1b[?1049h\x1b[?25l" + mouse_on)  # alternate screen, hide cursor, mouse
        draw()
        keys = re.compile(r"\x1b\[<\d+;\d+;\d+[Mm]|\x1b\[[0-9;?]*[~A-Za-z]|\x1bO[A-Za-z]|.", re.S)
        while True:
            timeout = max(st["flash"][1] - time.time(), 0) if st["flash"] else None
            ready = select.select([fd, wake_r], [], [], timeout)[0]
            if st["flash"] and time.time() >= st["flash"][1]:
                if st["msg"] == st["flash"][0]:
                    st["msg"] = ""
                st["flash"] = None
            if wake_r in ready:
                os.read(wake_r, 1024)
                st["cur"]["cols"] = 0  # force a re-render even if only the height changed
            if fd in ready:
                data = os.read(fd, 1024).decode("utf-8", "replace")
                for key in keys.findall(data):
                    if not handle(key):
                        return True
            draw()
    finally:
        out.write(mouse_off + "\x1b[0m\x1b[?25h\x1b[?1049l")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
        signal.signal(signal.SIGWINCH, old_handler)
        for f in (fd, wake_r, wake_w):
            os.close(f)


def directory_listing(path, title):
    """A Markdown document listing a directory, one link per entry."""
    def esc(name):
        return re.sub(r"([\\`*_\[\]~<>])", r"\\\1", name)

    names = [n for n in os.listdir(path) if not n.startswith(".")]
    names.sort(key=lambda n: (not os.path.isdir(os.path.join(path, n)), n.lower()))
    items = []
    for n in names:
        slash = "/" if os.path.isdir(os.path.join(path, n)) else ""
        items.append("- [%s%s](%s%s)" % (esc(n), slash, urllib.parse.quote(n), slash))
    return "# %s\n\n%s\n" % (title, "\n".join(items) or "*(empty)*")


def main():
    ap = argparse.ArgumentParser(prog="mdv", description="Display Markdown nicely in the terminal.")
    ap.add_argument("files", nargs="*", help="Markdown files (none or '-' reads stdin)")
    ap.add_argument("-w", "--width", type=int, help="wrap width (default: full terminal width, follows resizes)")
    ap.add_argument("-P", "--no-pager", action="store_true", help="print directly, never page")
    ap.add_argument("-p", "--page", action="store_true", help="always open the pager, even for short documents")
    ap.add_argument(
        "--pager",
        choices=["builtin", "less"],
        default=os.environ.get("MDV_PAGER", "builtin"),
        help="pager for long output (default: $MDV_PAGER or builtin, which re-wraps on resize and follows links)",
    )
    ap.add_argument("--no-mouse", action="store_true", help="builtin pager: leave the mouse to the terminal")
    ap.add_argument("--color", choices=["auto", "always", "never"], default="auto")
    ap.add_argument(
        "-t",
        "--theme",
        choices=["auto"] + list(THEMES),
        default=os.environ.get("MDV_THEME", DEFAULT_THEME),
        help="colour theme (default: $MDV_THEME or auto: paper on a light terminal, midnight otherwise)",
    )
    ap.add_argument("-l", "--language", help="show the input as source code in this language (e.g. for stdin)")
    ap.add_argument("--list-themes", action="store_true", help="preview every theme and exit")
    ap.add_argument("--pdf", action="store_true", help="write a styled PDF instead of printing (needs Chrome or WeasyPrint)")
    ap.add_argument("-o", "--output", metavar="FILE", help="with --pdf: output file (default: FILE.pdf next to each input)")
    ap.add_argument("--paper", choices=list(PAPERS), default=os.environ.get("MDV_PAPER", "a4").lower(),
                    help="with --pdf: paper size (default: $MDV_PAPER or a4)")
    args = ap.parse_args()
    if args.theme not in THEMES and args.theme != "auto":
        ap.error("unknown theme %r (MDV_THEME); choose from: auto, %s" % (args.theme, ", ".join(THEMES)))
    if args.pager not in ("builtin", "less"):
        ap.error("unknown pager %r (MDV_PAGER); choose from: builtin, less" % args.pager)

    if args.pdf and args.list_themes:
        ap.error("--pdf cannot be combined with --list-themes")
    if args.output and not args.pdf:
        ap.error("--output only applies with --pdf")
    if args.output and len(args.files) > 1:
        ap.error("--output takes a single input file")
    if args.pdf and args.paper not in PAPERS:
        ap.error("unknown paper %r (MDV_PAPER); choose from: %s" % (args.paper, ", ".join(PAPERS)))

    tty = sys.stdout.isatty()
    if args.color == "auto":
        color = tty and not os.environ.get("NO_COLOR")
    else:
        color = args.color == "always"
    theme = args.theme
    if theme == "auto":
        theme = "paper" if color and detect_light_background() else "midnight"
    build_theme(theme, color)

    files = [] if args.list_themes else (args.files or ["-"])
    texts = []
    for path in files:
        try:
            if path == "-":
                texts.append(sys.stdin.read())
            else:
                with open(path, encoding="utf-8", errors="replace") as f:
                    texts.append(f.read())
        except OSError as e:
            print("mdv: %s: %s" % (path, e.strerror), file=sys.stderr)
            return 1

    if args.pdf:
        status = 0
        for path, text in zip(files, texts):
            if args.output:
                out_path = args.output
            elif path == "-":
                out_path = "mdv.pdf"
            else:
                out_path = os.path.splitext(path)[0] + ".pdf"
            name = "stdin" if path == "-" else os.path.basename(path)
            base = os.getcwd() if path == "-" else os.path.dirname(os.path.abspath(path))
            lang = args.language or (os.path.basename(path) if path != "-" and is_source(path) else None)
            err = write_pdf(html_document(text, name, base, PAPERS[args.paper], lang), out_path)
            if err:
                print("mdv: %s: %s" % (path, err), file=sys.stderr)
                status = 1
            else:
                print("mdv: wrote %s" % out_path, file=sys.stderr)
        return status

    def build_first(cols):
        width = args.width or cols
        out, CTX["links"], CTX["zones"] = [], [], DECO
        if args.list_themes:
            for name, t in THEMES.items():
                build_theme(name, color)
                title = "%s  (for %s backgrounds%s)" % (name, t["for"], ", default" if name == theme else "")
                out += render_document("## " + title + "\n\n" + THEME_SAMPLE, min(width, 72)) + ["", ""]
            build_theme(theme, color)
            return out, CTX["links"]
        for idx, (path, text) in enumerate(zip(files, texts)):
            CTX["base"] = os.path.dirname(os.path.abspath(path)) if path != "-" else os.getcwd()
            if len(files) > 1:
                if idx:
                    out += ["", ""]
                out += [zmark(DECO) + T["muted"] + "── " + path + " " + "─" * max(width - len(path) - 4, 0) + R, ""]
            if args.language:
                out += code_block(text.expandtabs(4).split("\n"), args.language, width, numbers=True)
            elif path != "-" and is_source(path):
                out += render_source(text, os.path.basename(path), width)
            else:
                out += render_document(text, width)
        return out, CTX["links"]

    def make_doc(title, text, base, source=None):
        def build(cols):
            CTX["base"], CTX["links"], CTX["zones"] = base, [], DECO
            if source:
                return render_source(text, source, args.width or cols), CTX["links"]
            return render_document(text, args.width or cols), CTX["links"]

        return {"title": title, "build": build}

    def open_path(path):
        """Open a link target in the pager: Markdown, a directory, or any text file."""
        rel = os.path.relpath(path)
        if os.path.isdir(path):
            for name in ("README.md", "readme.md", "Readme.md", "index.md"):
                if os.path.isfile(os.path.join(path, name)):
                    path, rel = os.path.join(path, name), os.path.join(rel, name)
                    break
            else:
                try:
                    return make_doc(rel + "/", directory_listing(path, rel + "/"), path), None
                except OSError as e:
                    return None, "Cannot open %s: %s" % (rel, e.strerror)
        try:
            if os.path.getsize(path) > MAX_FILE:
                return None, "File too large: " + rel
            with open(path, "rb") as f:
                data = f.read()
        except OSError as e:
            return None, "Cannot open %s: %s" % (rel, e.strerror)
        if b"\0" in data[:8192]:
            return None, "Binary file: " + rel
        text = data.decode("utf-8", "replace")
        source = os.path.basename(path) if is_source(path) else None
        return make_doc(rel, text, os.path.dirname(path), source), None

    cols, rows = shutil.get_terminal_size((80, 24))
    out = build_first(cols)[0]
    if tty and not args.no_pager and (args.page or len(out) >= rows):
        title = "themes" if args.list_themes else ", ".join("stdin" if f == "-" else f for f in files)
        first = {"title": title, "build": build_first}
        if args.pager == "builtin" and page(first, open_path, mouse=not args.no_mouse):
            return 0
        try:
            env = dict(os.environ, LESSCHARSET="utf-8")
            pager = subprocess.Popen(["less", "-R"], stdin=subprocess.PIPE, env=env)
            try:
                pager.communicate(("\n".join(plain_marks(out)) + "\n").encode("utf-8"))
            except (BrokenPipeError, KeyboardInterrupt):
                pass
            return 0
        except OSError:
            pass
    try:
        sys.stdout.write("\n".join(plain_marks(out)) + "\n")
    except BrokenPipeError:
        pass
    return 0


def plain_marks(lines):
    return [MARK_RE.sub("", line) for line in lines]


if __name__ == "__main__":
    sys.exit(main())
