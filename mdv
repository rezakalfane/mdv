def build_theme(name, color):
    """Expand a theme into the style table used by the renderer."""
    global T, R, PYGMENTS_STYLE
    t = THEMES[name]
    styles = {
        "h1": t["h1"], "h2": t["h2"], "h3": t["h3"], "h4": t["h4"], "h5": "1", "h6": "1;" + t["muted"],
        "bold": "1", "italic": "3", "strike": "9;" + t["muted"], "muted": t["muted"],
        "code": t["code"], "panel": t["panel"], "panel_fg": "38;5;253", "panel_label": t["label"],
        "lineno": "38;5;246",
        "link": t["link"], "url": t["muted"], "rule": t["line"], "bar": t["muted"], "table": t["line"],
        "bullet": t["accent"], "th": t["h2"], "check": t["ok"], "uncheck": t["muted"],
    }
    for kind in ("NOTE", "TIP", "IMPORTANT", "WARNING", "CAUTION"):
        styles[kind] = t[kind]
    T = {k: (sgr(v) if color else "") for k, v in styles.items()}
    R = sgr("0") if color else ""
    PYGMENTS_STYLE = t["pygments"] if color else None


def detect_light_background():
    """Best effort: ask the terminal for its background colour (OSC 11)."""
    fgbg = os.environ.get("COLORFGBG", "")
    if fgbg:
        try:
            return int(fgbg.split(";")[-1]) in (7, 15)
        except ValueError:
            pass
    try:
        import select
        import termios
        import tty

        fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except (ImportError, OSError):
        return False
    buf = b""
    try:
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            os.write(fd, b"\x1b]11;?\x07")
            while select.select([fd], [], [], 0.15)[0]:
                buf += os.read(fd, 64)
                if buf.endswith(b"\x07") or buf.endswith(b"\x1b\\"):
                    break
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
    except (OSError, termios.error):
        return False
    finally:
        os.close(fd)
    m = re.search(rb"rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)", buf)
    if not m:
        return False
    r, g, b = (int(x, 16) / (16 ** len(x) - 1) for x in m.groups())
    return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.5


# ---------------------------------------------------------------- text width


def vwidth(s):
    """Visible width of a string: ignores ANSI codes, counts wide chars as 2."""
    w = 0
    for ch in MARK_RE.sub("", ANSI_RE.sub("", s)):
        if unicodedata.combining(ch) or ch in "‍️":
            continue
        w += 2 if unicodedata.east_asian_width(ch) in "WF" else 1
    return w


def chunks(tok, width):
    """Hard-split a word that is wider than the line."""
    out, cur, cw = [], "", 0
    for part in re.findall(r"\x1b\[[0-9;]*m|.", tok, re.S):
        pw = 0 if part.startswith("\x1b") else vwidth(part)
        if cw and cw + pw > width:
            out.append(cur)
            cur, cw = "", 0
        cur += part
        cw += pw
    out.append(cur)
    return out


def wrap(text, width):
    """Greedy word wrap that ignores ANSI codes and carries styles across lines."""
    width = max(width, 1)
    out, active = [], ""
    for para in text.split("\n"):
        cur, cur_w = active, 0
        for tok in re.findall(r"[ \t]+|[^ \t]+", para):
            if tok[0] in " \t":
                if cur_w:
                    cur += " "
                    cur_w += 1
                continue
            w = vwidth(tok)
            for idx, piece in enumerate(chunks(tok, width) if w > width else [tok]):
                pw = vwidth(piece)
                if cur_w and cur_w + pw > width:
                    soft = zmark(SOFT_JOIN if idx else SOFT_SPACE)  # mid-word split or between words
                    out.append(cur.rstrip(" ") + soft + (R if active else ""))
                    cur, cur_w = active, 0
                cur += piece
                cur_w += pw
                for code in ANSI_RE.findall(piece):
                    active = "" if code == R else active + code
        out.append(cur.rstrip(" ") + (R if active else ""))
    return out


def pad(s, w, align):
    extra = max(w - vwidth(s), 0)
    if align == "r":
        return " " * extra + s
    if align == "c":
        return " " * (extra // 2) + s + " " * (extra - extra // 2)
    return s + " " * extra


# -------------------------------------------------------------------- inline

INLINE_RE = re.compile(
    r"(?P<tick>`+)(?P<code>.+?)(?P=tick)"
    r"|!\[(?P<alt>[^\]]*)\]\((?P<src>[^)\s]*)[^)]*\)"
    r"|\[(?P<ltext>[^\]]+)\]\((?P<url>[^)\s]*)[^)]*\)"
    r"|<(?P<auto>(?:https?|mailto):[^>\s]+)>"
    r"|(?P<bm>\*\*|__)(?P<bold>.+?)(?P=bm)"
    r"|~~(?P<strike>.+?)~~"
    r"|(?<![\w*])\*(?P<em>[^*\s](?:.*?[^*\s])?)\*(?!\*)"
    r"|(?<![\w])_(?P<em2>[^_\s](?:.*?[^_\s])?)_(?![\w])"
    r"|\\(?P<esc>[\\`*_{}\[\]()#+\-.!|>~<])"
)
TAG_RE = re.compile(
    r"</?(?:kbd|sub|sup|b|i|em|strong|span|div|p|u|small|details|summary|img|a|"
    r"code|picture|source|center|h[1-6])\b[^>]*>",
    re.I,
)


def linked(url, rendered):
    """Record a link target and tag its rendered text with link marks."""
    if not url:
        return rendered
    if re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*:", url):
        if not url.startswith(("http:", "https:", "mailto:")):
            return rendered
        link = ("url", url, None)
    else:
        path, _, anchor = url.partition("#")
        path = urllib.parse.unquote(path)
        target = os.path.normpath(os.path.join(CTX["base"], path)) if path else None
        link = ("file", target, anchor or None)
    lid = len(CTX["links"])
    if lid >= LINK_END - LINK_START:
        return rendered
    CTX["links"].append(link)
    return chr(LINK_START + lid) + rendered + chr(LINK_END + lid)


def plain(line):
    return MARK_RE.sub("", ANSI_RE.sub("", line))


def inline(text, base=""):
    """Render inline Markdown; `base` is the style to restore after each span."""
    out, pos = [], 0

    def span(style, inner):
        return style + inline(inner, base + style) + R + base

    for m in INLINE_RE.finditer(text):
        out.append(TAG_RE.sub("", text[pos : m.start()]))
        pos = m.end()
        g = m.group
        if g("tick"):
            # One non-breaking space of padding inside the chip; it never wraps away.
            padding = " " if T["code"] else ""
            if padding:
                padding = zmark(SKIP) + padding
            out.append(T["code"] + padding + g("code").strip() + padding + R + base)
        elif g("src") is not None:
            out.append(T["muted"] + "[image" + (": " + g("alt") if g("alt") else "") + "]" + R + base)
        elif g("ltext"):
            url = g("url")
            out.append(linked(url, span(T["link"], g("ltext"))))
            if url and url != g("ltext") and not url.startswith("#"):
                out.append(" " + T["url"] + "(" + url + ")" + R + base)
        elif g("auto"):
            out.append(linked(g("auto"), T["link"] + g("auto") + R + base))
        elif g("bold"):
            out.append(span(T["bold"], g("bold")))
        elif g("strike"):
            out.append(span(T["strike"], g("strike")))
        elif g("em") or g("em2"):
            out.append(span(T["italic"], g("em") or g("em2")))
        elif g("esc"):
            out.append(g("esc"))
    out.append(TAG_RE.sub("", text[pos:]))
    return "".join(out)


# -------------------------------------------------------------------- blocks

FENCE_RE = re.compile(r"^(\s*)(`{3,}|~{3,})\s*([^`\s{]*)")
HEADING_RE = re.compile(r"^\s{0,3}(#{1,6})\s+(.*?)(?:\s+#+)?\s*$")
HR_RE = re.compile(r"^\s{0,3}([-*_])(\s*\1){2,}\s*$")
LIST_RE = re.compile(r"^(\s*)([-*+]|\d{1,9}[.)])(\s+|$)(.*)$")
QUOTE_RE = re.compile(r"^\s{0,3}>\s?(.*)$")
TABLE_SEP_RE = re.compile(r"^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$")
SETEXT_RE = re.compile(r"^\s{0,3}(=+|-+)\s*$")
ALERT_RE = re.compile(r"^\s*\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*$", re.I)
BULLETS = "•◦▪▫"


def indent_of(line):
    return len(line) - len(line.lstrip(" "))


def is_table(lines, i):
    return i + 1 < len(lines) and "|" in lines[i] and "|" in lines[i + 1] and bool(TABLE_SEP_RE.match(lines[i + 1]))


def starts_block(lines, i):
    line = lines[i]
    return bool(
        FENCE_RE.match(line)
        or HEADING_RE.match(line)
        or HR_RE.match(line)
        or QUOTE_RE.match(line)
        or LIST_RE.match(line)
        or is_table(lines, i)
    )


def find_lexer(hint):
    """Pygments lexer for a language name, an extension or a file name, or None."""
    try:
        from pygments.lexers import get_lexer_by_name, get_lexer_for_filename
        from pygments.util import ClassNotFound
    except ImportError:
        return None
    opts = {"stripnl": False, "ensurenl": False}
    for attempt in (
        lambda: get_lexer_by_name(hint.lower(), **opts),
        lambda: get_lexer_for_filename(hint, **opts),
        lambda: get_lexer_for_filename("x." + hint, **opts),
    ):
        try:
            return attempt()
        except (ClassNotFound, ValueError):
            pass
    return None


def shell_tokens(tokens):
    """Pygments leaves shell command names and flags as plain text: colour them."""
    from pygments.token import Token

    at_command = True
    for ttype, value in tokens:
        if ttype in Token.Text and value.strip():
            word = value.strip()
            if at_command and re.match(r"^[\w./~+@:-]+$", word):
                ttype, at_command = Token.Name.Function, False
            elif word.startswith("-"):
                ttype = Token.Name.Attribute
            else:
                at_command = False
        elif "\n" in value or ttype in Token.Generic.Prompt:
            at_command = True
        elif value.strip() in (";", "&&", "||", "|", "(", "$(", "`", "then", "do", "else", "elif", "if", "while",
                               "until", "time", "!"):
            at_command = True
        elif ttype in Token.Keyword or ttype in Token.Name.Builtin:
            at_command = False
        yield ttype, value


def highlight(code, lang):
    """Highlighted lines (one per source line), or the plain lines."""
    lexer = find_lexer(lang) if PYGMENTS_STYLE and lang else None
    if lexer is None:
        return code.split("\n")
    try:
        from pygments import format as pyg_format
        from pygments.formatters import Terminal256Formatter

        tokens = lexer.get_tokens(code)
        if {"bash", "sh", "console", "shell-session"} & set(lexer.aliases):
            tokens = shell_tokens(tokens)
        res = pyg_format(tokens, Terminal256Formatter(style=PYGMENTS_STYLE))
    except Exception:
        return code.split("\n")
    return res[:-1].split("\n") if res.endswith("\n") else res.split("\n")


def code_block(body, lang, width, numbers=False, hint=None):
    """A full box around a dark grey panel; long lines wrap inside the panel.

    `numbers` adds a line-number gutter (for whole source files); `hint` picks
    the highlighter (language, extension or file name) when it differs from the label.
    """
    if not numbers:
        while body and not body[0].strip():
            body.pop(0)
    while body and not body[-1].strip():
        body.pop()
    numw = len(str(len(body))) if numbers else 0
    gutter = numw + 2 if numbers else 0
    b, bg, fg = T["table"], T["panel"], T["panel_fg"]
    padx = 2  # spaces left and right of the code, inside the panel
    inner = max(width - 2 - 2 * padx - gutter, 1)  # "│" + padding + [number] + text + padding + "│"
    label = " " + lang + " " if lang else ""
    top = b + "╭─" + R + T["panel_label"] + label + R + b + "─" * max(width - 3 - len(label), 0) + "╮" + R

    zone = new_zone()

    def row(text, num="", blank=False, soft=""):
        number = T["lineno"] + num.rjust(numw) + "  " if numbers else ""
        content = fg + ("" if blank else zmark(zone)) + pad(text, inner, "l") + soft + zmark(DECO)
        return zmark(DECO) + b + "│" + R + bg + " " * padx + number + content + bg + " " * padx + R + b + "│" + R

    out = [zmark(DECO) + top, row("", blank=True)]  # one blank panel line above the code
    for n, line in enumerate(highlight("\n".join(body), hint or lang), 1):
        # Pygments resets bold/italic with SGR 0, which also clears the panel: restore it.
        if bg:
            line = ANSI_RE.sub(lambda m: m.group(0) + bg, line)
        pieces = chunks(line, inner) if vwidth(line) > inner else [line]
        for k, piece in enumerate(pieces):
            soft = zmark(SOFT_JOIN) if k < len(pieces) - 1 else ""  # a long line wrapped in the box
            out.append(row(piece, str(n) if k == 0 else "", soft=soft))
    out += [row("", blank=True), zmark(DECO) + b + "╰" + "─" * (width - 2) + "╯" + R]  # and one below
    return out


def heading(level, text, width):
    st = T["h%d" % level]
    prefix = {3: "◆ ", 4: "◇ "}.get(level, "")
    lines = wrap(st + deco(prefix) + inline(text, st) + R, width)
    if level == 1:
        lines.append(zmark(DECO) + T["h1"] + "━" * width + R)
    elif level == 2:
        lines.append(zmark(DECO) + T["rule"] + "─" * min(width, max(vwidth(l) for l in lines)) + R)
    return lines


def blockquote(body, width, depth):
    color, header = T["bar"], None
    if body and (a := ALERT_RE.match(body[0])):
        kind = a.group(1).upper()
        color, header = T[kind], T[kind] + kind.title() + R
        body = body[1:]
    inner = render(body, max(width - 2, 10), depth)
    if header:
        inner = [header] + inner
    return [deco(color + "│" + R + (" " if line else "")) + line for line in inner]


def table(rows, width):
    header = split_row(rows[0])
    ncol = len(header)
    aligns = []
    for c in split_row(rows[1])[:ncol]:
        aligns.append("c" if c.startswith(":") and c.endswith(":") else "r" if c.endswith(":") else "l")
    aligns += ["l"] * (ncol - len(aligns))
    head = [T["th"] + inline(c, T["th"]) + R for c in header]
    body = [[inline(c) for c in (split_row(r) + [""] * ncol)[:ncol]] for r in rows[2:]]

    widths = [max([vwidth(head[j])] + [vwidth(r[j]) for r in body] + [1]) for j in range(ncol)]
    avail = width - 3 * ncol - 1
    while sum(widths) > avail:
        j = widths.index(max(widths))
        if widths[j] <= 3:
            break
        widths[j] -= 1

    b = T["table"]
    sep = b + "│" + R

    zones = [new_zone() for _ in range(ncol)]

    def border(left, mid, right):
        return zmark(DECO) + b + left + mid.join("─" * (w + 2) for w in widths) + right + R

    def cell(text, j):
        """Cell text in its column zone; alignment padding is decoration."""
        extra = max(widths[j] - vwidth(text), 0)
        left = extra if aligns[j] == "r" else extra // 2 if aligns[j] == "c" else 0
        return " " * left + zmark(zones[j]) + text + zmark(DECO) + " " * (extra - left)

    def row(cells):
        wrapped = [wrap(c, widths[j]) for j, c in enumerate(cells)]
        lines = []
        for k in range(max(len(w) for w in wrapped)):
            parts = [cell(w[k] if k < len(w) else "", j) for j, w in enumerate(wrapped)]
            lines.append(zmark(DECO) + sep + sep.join(" " + p + " " for p in parts) + sep)
        return lines

    out = [border("┌", "┬", "┐")] + row(head) + [border("╞", "╪", "╡").replace("─", "═")]
    for k, r in enumerate(body):
        if k:
            out.append(border("├", "┼", "┤"))
        out += row(r)
    out.append(border("└", "┴", "┘"))
    return out


def split_row(line):
    s = line.strip()
    if s.startswith("|"):
        s = s[1:]
    if s.endswith("|") and not s.endswith("\\|"):
        s = s[:-1]
    return [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", s)]


def parse_list(lines, i):
    """Parse one list starting at line i: (items as line lists, loose, ordered, start number, next line)."""
    n = len(lines)
    first = LIST_RE.match(lines[i])
    base = len(first.group(1))
    ordered = first.group(2)[0].isdigit()
    start = int(first.group(2)[:-1]) if ordered else 0
    items, loose = [], False

    while i < n:
        m = LIST_RE.match(lines[i])
        if not m or len(m.group(1)) != base or m.group(2)[0].isdigit() != ordered or HR_RE.match(lines[i]):
            break
        content_col = len(m.group(1)) + len(m.group(2)) + len(m.group(3))
        body = [m.group(4)]
        i += 1
        while i < n:
            line = lines[i]
            if not line.strip():
                k = i
                while k < n and not lines[k].strip():
                    k += 1
                if k < n and indent_of(lines[k]) > base:
                    body += [""] * (k - i)
                    i, loose = k, True
                    continue
                break
            ind = indent_of(line)
            if ind > base:
                body.append(line[min(ind, content_col) :])
            elif starts_block(lines, i):
                break
            else:
                body.append(line.strip())  # lazy continuation
            i += 1
        items.append(body)
        k = i
        while k < n and not lines[k].strip():
            k += 1
        s = LIST_RE.match(lines[k]) if k < n else None
        if k > i and s and len(s.group(1)) == base and s.group(2)[0].isdigit() == ordered and not HR_RE.match(lines[k]):
            i, loose = k, True

    return items, loose, ordered, start, i


def list_block(lines, i, width, depth):
    items, loose, ordered, start, i = parse_list(lines, i)
    lw = (len(str(start + len(items) - 1)) + 2) if ordered else 2
    out = []
    for k, body in enumerate(items):
        task = re.match(r"^\[([ xX])\]\s+(.*)$", body[0])
        if task:
            label = T["check"] + "✔" + R if task.group(1) != " " else T["uncheck"] + "☐" + R
            body[0] = task.group(2)
        elif ordered:
            label = T["bullet"] + ("%d." % (start + k)).rjust(lw - 1) + R
        else:
            label = T["bullet"] + BULLETS[depth % len(BULLETS)] + R
        label += " " * (lw - vwidth(label))
        rendered = render(body, max(width - lw, 10), depth + 1)
        if not loose:
            rendered = [line for line in rendered if line]
        rendered = rendered or [""]
        out.append(deco(label) + rendered[0])
        out += [deco(" " * lw) + line if line else "" for line in rendered[1:]]
        if loose and k < len(items) - 1:
            out.append("")
    return out, i


def render(lines, width, depth=0):
    out = []
    i, n = 0, len(lines)
    while i < n:
        line = lines[i]
        if not line.strip():
            i += 1
            continue

        if m := FENCE_RE.match(line):
            ind, fence, lang = len(m.group(1)), m.group(2), m.group(3)
            close = re.compile(r"^\s*%s{%d,}\s*$" % (re.escape(fence[0]), len(fence)))
            body, i = [], i + 1
            while i < n and not close.match(lines[i]):
                body.append(lines[i][min(ind, indent_of(lines[i])) :])
                i += 1
            i += 1
            out += code_block(body, lang, width)
        elif m := HEADING_RE.match(line):
            out += heading(len(m.group(1)), m.group(2), width)
            i += 1
        elif HR_RE.match(line):
            out.append(zmark(DECO) + T["rule"] + "─" * width + R)
            i += 1
        elif QUOTE_RE.match(line):
            body = []
            while i < n and lines[i].strip():
                if q := QUOTE_RE.match(lines[i]):
                    body.append(q.group(1))
                elif starts_block(lines, i):
                    break
                else:
                    body.append(lines[i])
                i += 1
            out += blockquote(body, width, depth)
        elif LIST_RE.match(line):
            block, i = list_block(lines, i, width, depth)
            out += block
        elif is_table(lines, i):
            rows = [lines[i], lines[i + 1]]
            i += 2
            while i < n and lines[i].strip() and "|" in lines[i]:
                rows.append(lines[i])
                i += 1
            out += table(rows, width)
        elif line.startswith("    "):
            body = []
            while i < n and (lines[i].startswith("    ") or not lines[i].strip()):
                body.append(lines[i][4:])
                i += 1
            out += code_block(body, "", width)
        else:
            para, level = [line], 0
            i += 1
            while i < n and lines[i].strip():
                if s := SETEXT_RE.match(lines[i]):
                    level = 1 if s.group(1)[0] == "=" else 2
                    i += 1
                    break
                if starts_block(lines, i):
                    break
                para.append(lines[i])
                i += 1
            text = ""
            for k, p in enumerate(para):
                hard = p.endswith("  ") or p.rstrip().endswith("\\")
                s = p.strip()
                s = s[:-1] if s.endswith("\\") else s
                text += s + ("\n" if hard and k < len(para) - 1 else " ")
            text = re.sub(r"<br\s*/?>", "\n", text.strip(), flags=re.I)
            if level:
                out += heading(level, text, width)
            else:
                out += wrap(inline(text), width)
        out.append("")

    # collapse repeated blank lines
    clean = []
    for line in out:
        if line or (clean and clean[-1]):
            clean.append(line)
    while clean and not clean[-1]:
        clean.pop()
    return clean


def is_source(path):
    """True for files to show as code rather than Markdown."""
    name = os.path.basename(path)
    ext = os.path.splitext(name)[1].lower()
    if ext:
        return ext not in MARKDOWN_EXT
    return find_lexer(name) is not None  # Makefile, Dockerfile, ...


def render_source(text, name, width):
    """A whole source file: highlighted, with line numbers."""
    return code_block(text.expandtabs(4).split("\n"), name, width, numbers=True)


def render_document(text, width):
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    lines = text.expandtabs(4).splitlines()
    out = []
    if lines and lines[0].strip() == "---":  # YAML front matter
        for k in range(1, len(lines)):
            if lines[k].strip() in ("---", "..."):
                out += code_block(lines[1:k], "yaml", width) + [""]
                lines = lines[k + 1 :]
                break
    return out + render(lines, width)


