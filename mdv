ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
T = {}  # theme, filled by build_theme()
R = ""  # reset sequence ("" when colour is off)

# Links are tagged in the rendered text with invisible private-use characters
# (one start and one end mark per link id) so the pager can find, highlight and
# follow them after wrapping. They are removed before anything is printed.
LINK_START, LINK_END = 0xF0000, 0xF8000
MARK_RE = re.compile("[\U000F0000-\U0010FFFD]")

# Selection zones use the same trick: a zone mark says which region the
# following characters belong to, until the next zone mark or the end of the
# line. Decoration (borders, padding, bullets, line numbers) is never copied;
# each code block and each table column is its own zone.
ZONE_BASE = 0x100000
BODY, DECO = 0, 1
SKIP = 0xFFFC  # zone value meaning "only the next character is decoration"
SOFT_SPACE, SOFT_JOIN = 0xFFFB, 0xFFFA  # end of a wrapped line: rejoin with a space / with nothing
FLAGS = (SKIP, SOFT_SPACE, SOFT_JOIN)
CTX = {"base": ".", "links": [], "zones": DECO}  # base dir, links and zone counter of the current render


def zmark(zone):
    return chr(ZONE_BASE + zone)


def deco(text):
    """Decoration inside body text: not copied by a selection."""
    return zmark(DECO) + text + zmark(BODY) if text else text


def new_zone():
    if CTX["zones"] + 1 >= 0xFFF0:
        return BODY
    CTX["zones"] += 1
    return CTX["zones"]


def sgr(*codes):
    return "\x1b[" + ";".join(codes) + "m"


